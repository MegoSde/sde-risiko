<p>Kobl hvert forretningsasset til de systemer, det findes i eller afhænger af. Ændringer gemmes ved valg.</p>
<div id="mapping-list">
</div>
<section>
<h2>Systemasset</h2>
<form id="system-form">
<input type="hidden" name="id">
<label>Navn<input name="name" required>
</label>
<label>Beskrivelse<textarea name="description">
</textarea>
</label>
<label>Type<select name="assetType">
<option>Server</option>
<option>Network</option>
<option>Endpoint</option>
<option>Cloud</option>
<option>PersonAccount</option>
<option>Other</option>
</select>
</label>
<label>Zone<input name="zone">
</label>
<label>Blast Radius<input name="blastRadius" type="number" min="1" max="5" step="0.5" value="1" required>
</label>
<label>Begrundelse<textarea name="blastRadiusReason">
</textarea>
</label>
<button>Gem system</button>
<button type="reset">Annuller redigering</button>
</form>
</section>
