<p>Beskriv ledelsens processer og vurder fortrolighed, integritet og tilgængelighed fra 1–3.</p>
<section>
<h2 id="process-heading">Opret proces</h2>
<form id="process-form">
<input type="hidden" name="id">
<label>Navn<input name="name" required maxlength="160">
</label>
<label>Beskrivelse<textarea name="description">
</textarea>
</label>
<div class="fields">
<label>C<input name="confidentiality" type="number" min="1" max="3" value="1" required>
</label>
<label>I<input name="integrity" type="number" min="1" max="3" value="1" required>
</label>
<label>A<input name="availability" type="number" min="1" max="3" value="1" required>
</label>
<label>Konsekvens<input id="consequence" readonly value="1">
</label>
</div>
<button>Gem proces</button>
<button type="reset">Annuller redigering</button>
</form>
</section>
<div id="process-list">
</div>
<section>
<h2>Forretningsasset</h2>
<form id="asset-form">
<input type="hidden" name="id">
<label>Proces<select name="businessProcessId" required>
</select>
</label>
<label>Navn<input name="name" required>
</label>
<label>Beskrivelse<textarea name="description">
</textarea>
</label>
<button>Gem asset</button>
<button type="reset">Annuller redigering</button>
</form>
</section>
